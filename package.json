{
  "name": "auth-license-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --d1 DB=auth-demo --persist-to .data --port 8788",
    "db:init:local": "wrangler d1 execute auth-demo --local --persist-to .data --file=./db/schema.sql",
    "db:init:remote": "wrangler d1 execute auth-demo --remote --file=./db/schema.sql",
    "db:clean": "rm -rf .data",
    "test": "node test/e2e.mjs",
    "deploy": "wrangler pages deploy public --project-name auth-demo",
    "secret:webhook": "wrangler pages secret put CREEM_WEBHOOK_SECRET --project-name auth-demo",
    "sql": "wrangler d1 execute auth-demo --local --persist-to .data --command"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
